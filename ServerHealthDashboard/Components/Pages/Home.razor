@page "/"
@using ServerHealthDashboard.Components.Graphs

<PageTitle>Dashboard</PageTitle>

<section style="display: flex; height: 400px; gap: 0.5em;">
    <div style="display:flex; flex: 1; height: 100%; background-color: #24272f; border-radius: 4px;">
        <PerCoreUsageBarChart />
    </div>
    <div style="display:flex; flex: 1; height: 100%; background-color: #24272f; border-radius: 4px;">
        <TimeSeriesChart />
    </div>
    <div style="display:flex; height: 100%; background-color: #24272f; border-radius: 4px;">
        <MemoryUsageChart />
    </div>
</section>
<section style="display: flex; height: 650px; gap: 0.5em;">
    <div style="display:flex; height: 100%; min-width: 30%; background-color: #24272f; border-radius: 4px;">
        <ProcessesMetricsHeatmap />
    </div>
</section>
